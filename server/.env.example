HOST=127.0.0.1
PORT=3000
PATHNAME=/jam
MAX_ROOMS=100
MAX_CONNECTIONS=200
MAX_MESSAGE_BYTES=4096
MAX_EVENTS_PER_SECOND=10
EMPTY_ROOM_MS=300000
INACTIVE_ROOM_MS=1800000
MAX_ROOM_LIFETIME_MS=21600000
CLEANUP_INTERVAL_MS=30000

# Plugins older than this get "client_outdated" and an update dialog.
MIN_PLUGIN_VERSION=0.9.0
# Newest published plugin; users with an older one see "update available".
LATEST_PLUGIN_VERSION=0.9.0
# Where the plugin's "Update" button leads (t.me links open inside Telegram).
UPDATE_URL=https://t.me/shit_plugins
