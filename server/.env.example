HOST=127.0.0.1
PORT=3000
PATHNAME=/jam
MAX_ROOMS=100
MAX_CONNECTIONS=200
MAX_MESSAGE_BYTES=4096
MAX_EVENTS_PER_SECOND=10
EMPTY_ROOM_MS=300000
INACTIVE_ROOM_MS=1800000
MAX_ROOM_LIFETIME_MS=21600000
CLEANUP_INTERVAL_MS=30000

# Lobby size (2-50). The public server uses 5.
# Change it here and restart the server; the plugin reads the limit from the server.
MAX_PARTICIPANTS=5
# A host offline this long hands the host role to someone online.
HOST_HANDOFF_MS=15000
# One-time invite ticket lifetime.
INVITE_TTL_MS=300000
# A disconnected member leaves after this; a lost creator passes its role on.
MEMBER_GRACE_MS=120000
# Plugins older than this get "client_outdated" and an update dialog.
MIN_PLUGIN_VERSION=0.10.0
# Where the "Update" button in that dialog leads.
UPDATE_URL=https://t.me/shit_plugins
